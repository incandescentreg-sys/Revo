# --- Supabase ---
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# "anon" / "public" key (safe to expose to the client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# "service_role" key — SERVER ONLY. Never ship it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used to sign the custom JWT we mint for Telegram-authenticated users.
# Found in Supabase → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Telegram Bot ---
# From @BotFather, after creating the bot
TELEGRAM_BOT_TOKEN=1234567890:AAE_xxxx
# The bot username (without @) — public, used to build the deep link
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=my_momentum_bot

# --- App ---
# Public URL of the deployed app (used to build the auth callback link)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random secret used to sign the theme/notification preference cookie (optional)
SESSION_SECRET=change-me-to-a-long-random-string
# Protects the cron endpoint (send it as Authorization: Bearer <secret>)
CRON_SECRET=change-me-cron-secret

# --- Developer preview (optional) ---
# When no Telegram context is available (e.g. opening in a normal desktop
# browser), the app falls back to this Telegram ID so you can develop locally.
NEXT_PUBLIC_DEV_TELEGRAM_ID=123456789